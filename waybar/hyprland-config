{
	"layer": "top",
	"position": "top",
	"height": 36,

	"modules-left": [
		"hyprland/workspaces",
		"hyprland/submap",
		"hyprland/window"
	],

	"modules-right": [
		"tray",
		"pulseaudio",
		"network",
		"memory",
		"cpu",
		"temperature",
		"battery",
		"hyprland/language",
		"clock"
	],

	"battery": {
		"interval": 10,
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
		"format-charging": " {capacity}%",
		"format-full": "{icon} {capacity}%",
		"format-alt": "{icon} {power}W",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		],
		"tooltip": false
	},

	"clock": {
		"interval": 1,
		"format": " {:%H:%M}",
		"format-alt": " {:%e %b %Y}",
		"tooltip": false
	},

	"cpu": {
		"interval": 5,
		"format": " {usage}%",
		"format-alt": " {load}",
		"states": {
			"warning": 70,
			"critical": 90
		},
		"tooltip": false
	},

	"hyprland/language": {
		"format": " {}",
		"min-length": 5,
		"on-click": "hyprctl switchxkblayout all next",
		"tooltip": false
	},

	"hyprland/submap": {
		"format": "{}",
		"tooltip": false
	},

	"hyprland/window": {
		"format": "{}",
		"max-length": 40,
		"tooltip": false
	},

	"hyprland/workspaces": {
		"format": "{name}",
		"on-scroll-up": "hyprctl dispatch workspace e-1",
		"on-scroll-down": "hyprctl dispatch workspace e+1",
		"tooltip": false
	},

	"memory": {
		"interval": 5,
		"format": " {used:0.1f}G",
		"format-alt": " {used:0.1f}/{total:0.1f}G",
		"states": {
			"warning": 70,
			"critical": 90
		},
		"tooltip": false
	},

	"network": {
		"interval": 5,
		"format-wifi": " {essid}",
		"format-ethernet": " {ifname}",
		"format-disconnected": "disconnected",
		"format-alt": " {ipaddr}/{cidr}",
		"tooltip": false
	},

	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": " muted",
		"format-icons": {
			"headphone": "",
			"headset": "",
			"default": ["", "", ""]
		},
		"scroll-step": 1,
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"tooltip": false
	},

	"temperature": {
		"critical-threshold": 90,
		"interval": 5,
		"format": "{icon} {temperatureC}°",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		],
		"tooltip": false
	},

	"tray": {
		"icon-size": 16,
		"spacing": 6
	}
}
